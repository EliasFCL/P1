@model IEnumerable<Models.Producto>

@{
    ViewData["Title"] = "Details";
}

<h1>Buscar Producto</h1>
            @if (ViewBag.NoEncontrado != null)
            {
                <p style="color: darkorange;">
                    @ViewBag.NoEncontrado
                </p>
            }
            @if (ViewBag.Encontrado != null)
            {
                <p style="color: green;">
                    @ViewBag.Encontrado
                </p>
            }
<form asp-action="Details" method="get">
    <div class="form-group">
        <label for="busqueda">Código o nombre del producto</label>

        <input type="text" id="busqueda" name="busqueda" class="form-control"
               placeholder="Ingrese el código o nombre del producto" />
        <br />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>


@if (Model != null && Model.Any())
{
    <h4>Resultados</h4>
    <hr />
    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Unidad de Medida</th>
                <th>Precio</th>
                <th>Existencia</th>
                <th>Proveedor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var P in Model)
            {
                <tr>
                    <td>@P.codigo</td>
                    <td>@P.nombre</td>
                    <td>@P.categoria</td>
                    <td>@P.unidadMedida</td>
                    <td>@P.precio.ToString("N2") CRC</td>
                    <td>@P.existenciaActual</td>
                    <td>@P.proveedor</td>
                </tr>
            }
        </tbody>
    </table>
}
<div>
    <a asp-action="ProductoHome">Volver</a>
</div>