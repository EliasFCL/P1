@model Models.Producto

@{
    ViewData["Title"] = "Delete";
}

<h3> Esta seguro de eliminar este producto?</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Si" class="btn btn-danger" /> 
    </form>
<div>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
           Código
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.codigo)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Categoría
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.categoria)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Unidad de medida
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.unidadMedida)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Precio
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.precio)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Existencia actual
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.existenciaActual)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Existencia minima
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.existeciaMinima)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Proveedor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.proveedor)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="ProductoHome">Volver a la gestion</a> ||
    <a asp-action="IndexEliminar">Volver a la lista</a>
</div>
