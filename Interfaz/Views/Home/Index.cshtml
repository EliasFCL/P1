@* Botones: https://coreui.io/bootstrap/docs/components/card/ y https://learn.microsoft.com/de-de/aspnet/core/mvc/views/tag-helpers/built-in/anchor-tag-helper?view=aspnetcore-10.0&viewFallbackFrom=aspnetcore-3.0#1 *@
@* Manual: https://stackoverflow.com/questions/53723475/razor-translating-a-href-with-blank-noopener-noreffer-attributes-to-html-act/53724029#1*@


@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Gestión</h1>
    <p>Seleccione un módulo</p>
</div>

<div class="container mt-5">
    <div class="row">

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3>Clientes</h3>
                    <p>Administración de clientes</p>

                    <a asp-controller="Cliente"
                       asp-action="ClienteHome"
                       class="btn btn-primary">
                       Acceder
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3>Empleados</h3>
                    <p>Administración de empleados</p>

                    <a asp-controller="Empleado"
                       asp-action="EmpleadoHome"
                       class="btn btn-primary">
                        Acceder
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3>Productos</h3>
                    <p>Administración de productos</p>

                    <a asp-controller="Producto"
                       asp-action="ProductoHome"
                       class="btn btn-primary">
                        Acceder
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3>Proveedores</h3>
                    <p>Administración de proveedores</p>

                    <a asp-controller="Proveedor"
                       asp-action="ProveedorHome"
                       class="btn btn-primary">
                        Acceder
                    </a>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <p>
                <a target="_blank"
                   rel="noopener noreferrer"
                   href="@Url.Action("Manual", "Home")"
                   class="text-decoration-none">
                    Manual de uso del sistema
                </a>
            </p>
        </div>

    </div>
</div>