@model Models.Empleado

@{
    ViewData["Title"] = "Delete";
}

<h3>Esta seguro de eliminar a este empleado?</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Si" class="btn btn-danger" />
    </form>
<div>
    <hr />
     <dl class="row">
        <dt class = "col-sm-2">
            Tipo de identificación
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.tipoIdentificacion)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Identificación
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.numId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
             Nombre
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Primer apellido
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellido1)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Segundo apellido
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellido2)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha de nacimiento
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaNacimiento)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Salario
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.salario)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           Fecha de ingreso
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.fechaIngreso)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Aréa de trabajo
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.areaTrabajo)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Cargo
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cargo)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           Turno
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.turno)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <a asp-action="IndexEliminar">Volver a la lista</a> ||
        <a asp-action="EmpleadoHome">Volver a la gestión de empleados</a>
    </form>
</div>
