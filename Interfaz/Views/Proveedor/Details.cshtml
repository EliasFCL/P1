@model IEnumerable<Models.Proveedor>

@{
    ViewData["Title"] = "Details";
}

<h1>Buscar proveedor</h1>
            @if (ViewBag.NoEncontrado != null)
            {
                <p style="color: darkorange;">
                    @ViewBag.NoEncontrado
                </p>
            }
            @if (ViewBag.Encontrado != null)
            {
                <p style="color: green;">
                    @ViewBag.Encontrado
                </p>
            }
<form asp-action="Details" method="get">
    <div class="form-group">
        <label for="busqueda">Identificación o razón social</label>

        <input type="text"
               id="busqueda"
               name="busqueda"
               class="form-control"
               placeholder="Ingrese la identificación o razón social" />

        <br />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>
@if (Model != null && Model.Any())
{
    <h4>Resultados</h4>
    <hr />
    <table class="table">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Razón Social</th>
                <th>Nombre</th>
                <th>Primer apellido</th>
                <th>Segundo apellido</th>
                <th>Correo electrónico</th>
                <th>Teléfono</th>
                <th>Tipo de suministro</th>
                <th>Frecuencia de entrega</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var P in Model)
            {
                <tr>
                    <td>@P.numId</td>
                    <td>@P.RazonSocial</td>
                    <td>@P.nombre</td>
                    <td>@P.apellido1</td>
                    <td>@P.apellido2</td>
                    <td>@P.CorreoElectronico</td>
                    <td>@P.Telefono</td>
                    <td>@P.CorreoElectronico</td>
                    <td>@P.TipoSuministro</td>
                    <td>@P.FrecuenciaEntrega</td>
                </tr>
            }
        </tbody>
    </table>
}
<div>
    <a asp-action="ProveedorHome">Volver</a>
</div>
