@model Models.Proveedor

@{
    ViewData["Title"] = "Details";
}

<h1>Buscar proveedor</h1>
            @if (ViewBag.NoEncontrado != null)
            {
                <p style="color: darkorange;">
                    @ViewBag.NoEncontrado
                </p>
            }
            @if (ViewBag.Encontrado != null)
            {
                <p style="color: green;">
                    @ViewBag.Encontrado
                </p>
            }
<form asp-action="Details" method="get">
    <div class="form-group">
        <label for="busqueda">Identificación o razón social</label>

        <input type="text"
               id="busqueda"
               name="busqueda"
               class="form-control"
               placeholder="Ingrese la identificación o razón social" />

        <br />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>
<div>
    <h4>Proveedor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Id único
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            Tipo de identificiación
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipoIdentificacion)
        </dd>
    <dt class="col-sm-2">
        Identificación
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.numId)
    </dd>
<dt class="col-sm-2">
    Nombre
</dt>
<dd class="col-sm-10">
    @Html.DisplayFor(model => model.nombre)
</dd>
        <dt class = "col-sm-2">
            Razón social
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RazonSocial)
        </dd>
        <dt class = "col-sm-2">
            Teléfono
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefono)
        </dd>
        <dt class = "col-sm-2">
            Correo electrónico
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CorreoElectronico)
        </dd>
        <dt class = "col-sm-2">
            Tipo de suministro
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoSuministro)
        </dd>
        <dt class = "col-sm-2">
            Frecuencia de entrega
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FrecuenciaEntrega)
        </dd>
</div>
<div>
    <a asp-action="ProveedorHome">Volver</a>
</div>
