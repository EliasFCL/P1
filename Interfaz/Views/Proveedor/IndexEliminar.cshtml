@model IEnumerable<Models.Proveedor>

@{
    ViewData["Title"] = "Index";
}

<h1>Seleccione al proveedor que desea eliminar</h1>
@if (ViewBag.Eliminado != null)
{
    <p style="color: green;">
        @ViewBag.Eliminado
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                Id único
            </th>
            <th>
                Tipo de identificación
            </th>
            <th>
                Identificación
            </th>
            <th>
                Razón social
            </th>
            <th>
                Nombre
            </th>
            <th>
                Telefóno
            </th>
            <th>
                Correo electrónico
            </th>
            <th>
                Tipo de suministro
            </th>
            <th>
                Frecuencia de entrega
            </th>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
                        <td>
                @Html.DisplayFor(model => item.tipoIdentificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.numId)
            </td>
            <td>
                @Html.DisplayFor(model => item.RazonSocial)
            </td>
            <td>
                @Html.DisplayFor(model => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(model => item.CorreoElectronico)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoSuministro)
            </td>
            <td>
                @Html.DisplayFor(model => item.FrecuenciaEntrega)
            </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@item.Id">Seleccionar</a>
                </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-action="ProveedorHome">Volver</a>
</div>
