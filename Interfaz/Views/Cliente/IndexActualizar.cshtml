@model IEnumerable<Models.Cliente>

@{
    ViewData["Title"] = "Actualizar";
}

<h1>Seleccion el cliente a editar</h1>

@if (ViewBag.Actualizado != null)
{
    <p style="color: green;">
        @ViewBag.Actualizado
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                ID unico
            </th>
            <th>
                Tipo de identificación
            </th>
            <th>
                Identificación
            </th>
            <th>
                Nombre del cliente
            </th>
            <th>
                Primer apellido
            </th>
            <th>
                Segundo apellido
            </th>
            <th>
                Fecha de nacimiento
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(model => item.tipoIdentificacion)
                </td>
                <td>
                    @Html.DisplayFor(model => item.numId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.apellido1)
                </td>
                <td>
                    @Html.DisplayFor(model => item.apellido2)
                </td>
                <td>
                    @Html.DisplayFor(model => item.fechaNacimiento)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Seleccionar</a> 
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="ClienteHome">Volver</a>
</div>