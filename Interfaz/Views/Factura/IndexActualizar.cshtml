@model IEnumerable<Models.Factura>

@{
    ViewData["Title"] = "IndexActualizar";
}

<h1>Seleccione la factura a actualizar</h1>

@if (ViewBag.Actualizado != null)
{
    <p style="color: green;">@ViewBag.Actualizado</p>
}
@if (TempData["Error"] != null)
{
    <p style="color: darkorange;">@TempData["Error"]</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Número</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Empleado</th>
            <th>Producto</th>
            <th>Método de pago</th>
            <th>Descuento</th>
            <th>Total</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.numeroFactura</td>
                <td>@item.fecha.ToShortDateString()</td>
                <td>@item.nombreCliente</td>
                <td>@item.empleadoResponsable</td>
                <td>
                    @if (item.detalles != null && item.detalles.Any())
                    {
                        @string.Join(", ", item.detalles.Select(d => d.producto))
                    }
                    else
                    {
                        <span>Sin productos</span>
                    }
                </td>
                <td>@item.metodoPago</td>
                <td>@item.descuento %</td>
                <td>@item.total.ToString("N2") CRC</td>
                <td>@item.estado</td>
                <td>
                    <a asp-action="Edit" asp-route-numeroFactura="@item.numeroFactura">Seleccionar</a>
                </td>
                <td>
                    @if (item.estado == "Pagada")
                    {
                        <form asp-action="Anular" asp-route-numeroFactura="@item.numeroFactura" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('¿Seguro que desea anular esta factura? El inventario será devuelto.');">
                                Anular
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>