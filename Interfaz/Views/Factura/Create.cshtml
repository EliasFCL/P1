@*Entender margenes: https://coddy.tech/learn/es/html/styling_with_css/margins*@
@*Enlace de modelos: https://learn.microsoft.com/es-es/aspnet/core/mvc/models/model-binding?view=aspnetcore-10.0*@
@*Agregar filas dinamicamente: https://stackoverflow.com/questions/60497876/how-to-add-items-entered-in-a-dynamic-html-table-to-a-model-bound-list y
    https://developer.mozilla.org/es/docs/Web/API/Element/innerHTML*@
@*Mantener la fila si hay errores: https://learn.microsoft.com/zh-tw/archive/msdn-technet-forums/da7eed02-fc23-4774-a52d-c28798390372 y
https://learn.microsoft.com/en-us/archive/msdn-technet-forums/576686b3-85b2-425e-b9c4-d334a64fc93d#1
Adaptar calculo en tiempo real: https://stackoverflow.com/revisions/a1d67cac-3b85-4a39-aaad-c0f918a3f65d/view-source*@

@model Models.Factura

@{
    ViewData["Title"] = "Crear Factura";
    var productos = (List<Models.Producto>)ViewBag.Productos ?? new List<Models.Producto>();
}

<h1>Registrar factura</h1>

<hr />

<div class="row">
    <div class="col-md-9">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            @if (ViewBag.MensajeExito != null)
            {
                <p style="color: green;">@ViewBag.MensajeExito</p>
            }

            <div class="form-group">
                <label class="control-label">Número de factura</label>
                 <input asp-for="numeroFactura" type="hidden" />
                <input value="@Model.numeroFactura" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">Fecha</label>
                 <input asp-for="fecha" type="hidden" />
                <input value="@Model.fecha.ToString("dd/MM/yyyy HH:mm")" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">Cliente</label>
                <select asp-for="nombreCliente" class="form-control">
                    <option value=""> Seleccione un cliente </option>
                    @if (ViewBag.Clientes != null)
                    {
                        foreach (var nombre in ViewBag.Clientes)
                        {
                            <option value="@nombre">@nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Empleado</label>
                <select asp-for="empleadoResponsable" class="form-control">
                    <option value=""> Seleccione un empleado </option>
                    @if (ViewBag.Empleados != null)
                    {
                        foreach (var nombre in ViewBag.Empleados)
                        {
                            <option value="@nombre">@nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Método de pago</label>
                <select asp-for="metodoPago" class="form-control">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="SINPE Móvil">SINPE Móvil</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Porcentaje de descuento</label>
                <input asp-for="descuento" type="number" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Estado</label>
                <select asp-for="estado" class="form-control">
                    <option value="Pendiente">Pendiente</option>
                    <option value="Pagada">Pagada</option>
                    <option value="Anulada">Anulada</option>
                </select>
            </div>

            <h3>Detalle de factura</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Unidad</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cuerpoDetalles">
                    <!-- Guardar la fila si hay errores -->
                    @if (Model.detalles != null)
                    {
                        for (int i = 0; i < Model.detalles.Count; i++)
                        {
                            var detalle = Model.detalles[i];
                            <tr>
                                <td>
                                    <select name="detalles[@i].producto" class="form-control" onchange="copiarProducto(this)">
                                        <option value="">Seleccione un producto</option>
                                        @foreach (var p in productos)
                                        {
                                            <option value="@p.nombre" data-unidad="@p.unidadMedida" data-precio="@p.precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(p.nombre == detalle.producto)">@p.nombre</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="text" class="form-control unidad" name="detalles[@i].unidadMedida" value="@detalle.unidadMedida" readonly /></td>
                                <td><input type="number" min="1" class="form-control" name="detalles[@i].cantidad" value="@detalle.cantidad" /></td>
                                <td><input type="number" step="0.01" class="form-control precio" name="detalles[@i].precioUnitario" value="@detalle.precioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" readonly /></td>
                                <td><button type="button" class="btn btn-danger" onclick="this.closest('tr').remove()">X</button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-secondary" onclick="agregarFila()">Agregar detalle</button>

            <div style="margin-top: 15px;">
                <input type="submit" value="Registrar factura" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="FacturaHome">Volver</a>
</div>

<script>
    let indice = @(Model.detalles?.Count ?? 0);

    function agregarFila() {
        //Apuntar al cuerpo de la tabla
        var cuerpo = document.getElementById("cuerpoDetalles");

        //Insertar fila en última posición
        var fila = cuerpo.insertRow(-1);

         //Celda 1: Producto
        var celda1 = fila.insertCell(0);
        celda1.innerHTML = `
                    <select name="detalles[${indice}].producto" class="form-control" onchange="copiarProducto(this)">
                        <option value=""> Seleccione un producto</option>
                        @foreach (var p in productos)
                        {
                                <option value="@p.nombre" data-unidad="@p.unidadMedida" data-precio="@p.precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.nombre</option>
                        }
                    </select>
                `;
        var celda2 = fila.insertCell(1);
        celda2.innerHTML = `<input type="text" class="form-control unidad" name="detalles[${indice}].unidadMedida" readonly />`;
        var celda3 = fila.insertCell(2);
        celda3.innerHTML = `<input type="number" min="1" value="1" class="form-control" name="detalles[${indice}].cantidad" onkeydown="return event.key != 'Enter';" oninput="this.closest('tr').querySelector('.subtotal').value = ((parseFloat(this.value) || 0) * (parseFloat(this.closest('tr').querySelector('.precio').value) || 0)).toFixed(2)" />`;
        var celda4 = fila.insertCell(3);
        celda4.innerHTML = `<input type="number" step="0.01" class="form-control precio" name="detalles[${indice}].precioUnitario" readonly />`;
        var celda5 = fila.insertCell(4);
        celda5.innerHTML = `<input type="number" step="0.01" class="form-control subtotal" name="detalles[${indice}].subtotal" readonly />`;
        var celda6 = fila.insertCell(5);
        celda6.innerHTML = `<button type="button" class="btn btn-danger" onclick="this.closest('tr').remove()">X</button>`;

       indice++;
    }

    //Autocompletar datos
    function copiarProducto(select) {
        const fila = select.closest("tr");
        const opcion = select.selectedOptions[0];
        fila.querySelector(".unidad").value = opcion.dataset.unidad || "";
        fila.querySelector(".precio").value = opcion.dataset.precio || "";
        calcularSubtotal(select);
    }

    function calcularSubtotal(elemento) {
        //Encontrar la fila donde se escribe
        const fila = elemento.closest("tr");
        
        //Obtener la cantidad y el precio 
        const cantidad = parseFloat(fila.querySelector("input[name$='.cantidad']").value) || 0;
        const precio = parseFloat(fila.querySelector(".precio").value) || 0;
        
        // Calcular y poner el subtotal en su celda
        const subtotal = cantidad * precio;
        fila.querySelector(".subtotal").value = subtotal.toFixed(2);
    }

    //window.addEventListener("DOMContentLoaded", agregarFila);//Fila por defecto al cargar la página
</script>