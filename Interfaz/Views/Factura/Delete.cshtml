@model Models.Factura

@{
    ViewData["Title"] = "Delete";
}

<h3>¿Está seguro de eliminar esta factura?</h3>
<form asp-action="Delete">
    <input type="hidden" asp-for="numeroFactura" />
    <input type="submit" value="Sí" class="btn btn-danger" />
</form>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Número de factura</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.numeroFactura)</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.fecha)</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.nombreCliente)</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Empleado responsable</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.empleadoResponsable)</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Método de pago</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.metodoPago)</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Descuento</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.descuento) %</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Subtotal</dt>
        <dd class="col-sm-10">@Model.subtotal.ToString("N2") CRC</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">IVA</dt>
        <dd class="col-sm-10">@Model.iva.ToString("N2") CRC</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">@Model.total.ToString("N2") CRC</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.estado)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="numeroFactura" />
        <a asp-action="FacturaHome">Volver</a> 
    </form>
</div>