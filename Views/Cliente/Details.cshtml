@model Proyecto1_EliasCorderoLeon.Models.Cliente

@{
    ViewData["Title"] = "Buscar Cliente";
}

<h1>Buscar Cliente</h1>
            @if (ViewBag.NoEncontrado != null)
            {
                <p style="color: red;">
                    @ViewBag.NoEncontrado
                </p>
            }
            @if (ViewBag.Encontrado != null)
            {
                <p style="color: green;">
                    @ViewBag.Encontrado
                </p>
            }
<form asp-action="Details" method="get">
    <div class="form-group">
        <label for="numId">Número de identificación</label>

        <input type="text"
               id="numId"
               name="numId"
               class="form-control"
               placeholder="Ingrese el número de identificación" />

        <br />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>

@if (Model != null)
{
    <hr />

    <h4>Información del Cliente</h4>

    <dl class="row">
                <dt class="col-sm-2">
            ID unico
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            Tipo de identificación
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.tipoIdentificacion)
        </dd>

        <dt class="col-sm-2">
            Identificación
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.numId)
        </dd>

        <dt class="col-sm-2">
            Nombre del cliente
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.nombre)
        </dd>

        <dt class="col-sm-2">
            Primer apellido
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.apellido1)
        </dd>

        <dt class="col-sm-2">
            Segundo apellido
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.apellido2)
        </dd>

        <dt class="col-sm-2">
            Fecha de nacimiento
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.fechaNacimiento)
        </dd>

    </dl>
}

<br />

<div>
    <a asp-action="ClienteHome">volver</a>
</div>