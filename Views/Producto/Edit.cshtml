@model Proyecto1_EliasCorderoLeon.Models.Producto

@{
    ViewData["Title"] = "Edit";
}

<h1>Actualizar producto</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="control-label">Código</label>
                <input asp-for="codigo" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Nombre</label>
                <input asp-for="nombre" class="form-control" />
            </div>
            <div class="form-group">
                @*Drop box para la categoría*@
                <label class="control-label">Categoría</label>
                <select asp-for="categoria" class="form-control" />
                <option value="Carne de res">Carne de res</option>
                <option value="Carne de cerdo">Carne de cerdo</option>
                <option value="Pollo">Pollo</option>
                <option value="Embutidos">Embutidos</option>
                <option value="Productos procesados">Productos procesados</option>
                 <option value="Congelados">Congelados</option>
                <option value=" Otros">Otros</option>
            </select>
            <div class="form-group">
                @*Drop box para la unidad de medida*@
                <label class="control-label">Unidad de medida</label>
                <select asp-for="unidadMedida" class="form-control" />
                <option value="Kilogramo">Kilogramo</option>
                <option value="Libra">Libra</option>
                <option value="Unidad">Unidad</option>
                <option value="Paquete">Paquete</option>
                <option value="Bandeja">Bandeja</option>
            </select>
            <div class="form-group">
                <label class="control-label">Precio</label>
                <input asp-for="precio" class="form-control"
                       onkeydown="return event.key !== '.';" />
            </div>
            <div class="form-group">
                <label class="control-label">Existencia actual</label>
                <input asp-for="existenciaActual" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Existencia minima</label>
                <input asp-for="existeciaMinima" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="IndexActualizar">Volver a la lista</a> ||
    <a asp-action="ProductoHome">Volver a la gestión de productos</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script>
    document.getElementById("categoria").addEventListener("change", verificarCombinacion);
    document.getElementById("unidadMedida").addEventListener("change", verificarCombinacion);
    verificarCombinacion();
    function verificarCombinacion() {

        var categoria = document.getElementById("categoria").value;
        var unidadMedida = document.getElementById("unidadMedida").value;

        fetch('@Url.Action("verificarCombinacion", "Producto")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'categoria=' + encodeURIComponent(categoria) +
                '&unidadMedida=' + encodeURIComponent(unidadMedida)
        })
            .then(response => response.json())
            .then(data => {

                var precio = document.getElementById("precio");

                if (data.existe) {
                    precio.value = data.precio.toString().replace(/\,/g, '.');
                    precio.readOnly = true;
                }
                else {
                    precio.value = "";
                    precio.readOnly = false;
                }
            });
    }
</script>
