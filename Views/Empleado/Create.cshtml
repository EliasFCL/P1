@*Script adaptado de: https://wordpress.org/support/topic/how-to-auto-update-a-dropdown-based-on-a-previous-selection-in-wpforms/#1 y
    https://stackoverflow.com/questions/62341661/how-to-dynamically-add-an-array-to-a-dropdown-depending-on-another-dropdown-list
*@
@*Radio button: https://learn.microsoft.com/en-au/answers/questions/1186498/radio-buttons#1*@

@model Proyecto1_EliasCorderoLeon.Models.Empleado

@{
    ViewData["Title"] = "Create";
}

<h1>Digite los datos del empleado</h1>

<h4>Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (ViewBag.MensajeExito != null)
            {
                <p style="color: green;">
                    @ViewBag.MensajeExito
                </p>
            }
            <div class="form-group">
                @* Drop box para el tipo de identificación *@
                <label class="control-label">Tipo de indetificación</label>

                <select asp-for="tipoIdentificacion" class="form-control">
                    <option value="Cédula">Cédula</option>
                    <option value="DIMEX">DIMEX</option>
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Identificación</label>
                <input asp-for="numId" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Nombre del empleado</label>
                <input asp-for="nombre" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Primer apellido</label>
                <input asp-for="apellido1" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Segundo apellido</label>
                <input asp-for="apellido2" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Fecha de nacimiento</label>
                <input asp-for="fechaNacimiento" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Salario</label>
                <input asp-for="salario" class="form-control"
                 onkeydown="return event.key !== '.' && event.key !== ',';" />
            </div>

            <div class="form-group">
                <label class="control-label">Fecha de ingreso</label>
                <input asp-for="fechaIngreso" class="form-control" />
            </div>

            <div class="form-group">
                @* Drop box para el área de trabajo *@
                <label class="control-label">Área de trabajo</label>

                <select asp-for="areaTrabajo" class="form-control">
                    <option value="">Seleccione un área</option>
                    <option value="Administracion">Administración</option>
                    <option value="Ventas y Caja">Ventas y Caja</option>
                    <option value="Servicio al cliente">Servicio al cliente</option>
                    <option value="Corte y Preparacion">Corte y Preparación</option>
                    <option value="Bodega e Inventario">Bodega e Inventario</option>
                    <option value="Distribucion">Distribución</option>
                    <option value="Limpieza">Limpieza</option>
                </select>
            </div>


            <div class="form-group">
                <label class="control-label">Cargo</label>

                <select asp-for="cargo" class="form-control" id="cargo">
                    <option value="">Primero seleccione un área</option>
                </select>
            </div>

            <script>
                            const cargosPorArea = {
                                "Administracion": ["Administrador", "Asistente administrativo"],
                                "Ventas y Caja": ["Cajero", "Vendedor"],
                                "Servicio al cliente": ["Servicio al cliente"],
                                "Corte y Preparacion": ["Carnicero", "Despostador", "Empacador"],
                                "Bodega e Inventario": ["Bodeguero", "Auxiliar de inventario"],
                                "Distribucion": ["Conductor", "Ayudante de distribución"],
                                "Limpieza": ["Personal de limpieza"]
                            };

                            const areaSelect = document.getElementById("areaTrabajo");
                            const cargoSelect = document.getElementById("cargo");

                            function cargarCargos() {
                                const area = areaSelect.value;
                                cargoSelect.innerHTML = "";

                                if (!area || !cargosPorArea[area]) {
                                    cargoSelect.innerHTML = '<option value="">Primero seleccione un área</option>';
                                    return;
                                }

                                cargosPorArea[area].forEach(c => {
                                    const opt = document.createElement("option");
                                    opt.value = c;
                                    opt.textContent = c;
                                    cargoSelect.appendChild(opt);
                                });
                            }

                            areaSelect.addEventListener("change", cargarCargos);
            </script>

            @*Para el radio buton*@
            @*Para el radio buton*@
            <div class="form-group">
                <label asp-for="turno" class="control-label"></label>

                <div class="form-check">
                    <input asp-for="turno" type="radio" value="Mañana" class="form-check-input" id="turnoManana" />
                    <label class="form-check-label" for="turnoManana">Mañana</label>
                </div>

                <div class="form-check">
                    <input asp-for="turno" type="radio" value="Tarde" class="form-check-input" id="turnoTarde" />
                    <label class="form-check-label" for="turnoTarde">Tarde</label>
                </div>

                <div class="form-check">
                    <input asp-for="turno" type="radio" value="Noche" class="form-check-input" id="turnoNoche" />
                    <label class="form-check-label" for="turnoNoche">Noche</label>
                </div>

                <span asp-validation-for="turno" class="text-danger"></span>
            </div>
</select>
            <div class="form-group">
                <input type="submit" value="Registrar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="EmpleadoHome">Volver</a>
</div>