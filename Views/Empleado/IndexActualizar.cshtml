@model IEnumerable<Proyecto1_EliasCorderoLeon.Models.Empleado>

@{
    ViewData["Title"] = "Index";
}

<h1>Seleccione el empleado a editar</h1>

@if (ViewBag.Actualizado != null)
{
    <p style="color: green;">
        @ViewBag.Actualizado
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                ID único
            </th>
            <th>
                Tipo de identificación
            </th>
            <th>
                Identificación
            </th>
            <th>
                Nombre
            </th>
            <th>
                Primer apellido
            </th>
            <th>
                Segundo apellido
            </th>
            <th>
                Fecha de nacimiento
            </th>
            <th>
                Salario
            </th>
            <th>
                Fecha de ingreso
            </th>
        <th>
            Aréa de trabajo
        </th>
        <th>
            Cargo
        </th>
        <th>
            Turno
        </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.tipoIdentificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.numId)
            </td>
            <td>
                @Html.DisplayFor(model => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.apellido1)
            </td>
            <td>
                @Html.DisplayFor(model => item.apellido2)
            </td>
            <td>
                @Html.DisplayFor(model => item.fechaNacimiento)
            </td>
            <td>
                    @item.salario.ToString("N2") CRC
            </td>
            <td>
                @Html.DisplayFor(model => item.fechaIngreso)
            </td>
            <td>
                @Html.DisplayFor(model => item.areaTrabajo)
            </td>
            <td>
                @Html.DisplayFor(model => item.cargo)
            </td>
            <td>
                @Html.DisplayFor(model => item.turno)
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Seleccionar</a>
                    </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-action="EmpleadoHome">Volver</a>
</div>