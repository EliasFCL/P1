@model Proyecto1_EliasCorderoLeon.Models.Empleado

@{
    ViewData["Title"] = "Buscar Empleado";
}

<h1>Buscar Empleado</h1>
            @if (ViewBag.NoEncontrado != null)
            {
                <p style="color: red;">
                    @ViewBag.NoEncontrado
                </p>
            }
            @if (ViewBag.Encontrado != null)
            {
                <p style="color: green;">
                    @ViewBag.Encontrado
                </p>
            }
<form asp-action="Details" method="get">
    <div class="form-group">
        <label for="numId">Número de identificación</label>

        <input type="text"
               id="numId"
               name="numId"
               class="form-control"
               placeholder="Ingrese el número de identificación" />

        <br />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>

@if (Model != null)
{
    <div>
        <h4>Empleado</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                Id único
            </dt>
                        <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class="col-sm-2">
                Tipo de identificación
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.tipoIdentificacion)
            </dd>

            <dt class="col-sm-2">
                Identificación
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.numId)
            </dd>

            <dt class="col-sm-2">
                Nombre
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.nombre)
            </dd>

            <dt class="col-sm-2">
                Primer apellido
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.apellido1)
            </dd>

            <dt class="col-sm-2">
                Segundo apellido
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.apellido2)
            </dd>

            <dt class="col-sm-2">
                Fecha de nacimiento
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.fechaNacimiento)
            </dd>

            <dt class="col-sm-2">
                Salario
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.salario)
            </dd>

            <dt class="col-sm-2">
                Fecha ingreso
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.fechaIngreso)
            </dd>

            <dt class="col-sm-2">
                Aréa de trabajp
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.areaTrabajo)
            </dd>

            <dt class="col-sm-2">
                Cargo
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.cargo)
            </dd>

            <dt class="col-sm-2">
                Turno
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.turno)
            </dd>

        </dl>
    </div>
}

<div>
    <a asp-action="EmpleadoHome">Volver</a>
</div>