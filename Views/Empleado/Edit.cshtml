@model Proyecto1_EliasCorderoLeon.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<h1>Editar Empleado</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                 <label class="control-label">Tipo de identificacón</label>

                <select asp-for="tipoIdentificacion" class="form-control">
                    <option value="Cédula">Cédula</option>
                    <option value="DIMEX">DIMEX</option>
                </select>
            </div>

            <div class="form-group">
                 <label class="control-label">Identificación</label>
                <input asp-for="numId" class="form-control" />
            </div>

            <div class="form-group">
               <label class="control-label">Nombre</label>
                <input asp-for="nombre" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Primer apellido</label>
                <input asp-for="apellido1" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Segundo apellido</label>
                <input asp-for="apellido2" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Fecha de nacimiento</label>
                <input asp-for="fechaNacimiento" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Salario</label>
                <input asp-for="salario" class="form-control"
                onkeydown="return event.key !== '.' && event.key !== ',';" />
            </div>

            <div class="form-group">
                <label class="control-label">Fecha de ingreso</label>
                <input asp-for="fechaIngreso" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Aréa de trabajp</label>

                <select asp-for="areaTrabajo" name="areaTrabajo" class="form-control">
                    <option value="">Seleccione un área</option>
                    <option value="Administracion">Administración</option>
                    <option value="Ventas y Caja">Ventas y Caja</option>
                    <option value="Servicio al cliente">Servicio al cliente</option>
                    <option value="Corte y Preparacion">Corte y Preparación</option>
                    <option value="Bodega e Inventario">Bodega e Inventario</option>
                    <option value="Distribucion">Distribución</option>
                    <option value="Limpieza">Limpieza</option>
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Cargo</label>

                <select id="cargo" name="cargo" class="form-control">
                    <option value="">Seleccione un cargo</option>
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Turno</label>

                <div class="form-check">
                    <input asp-for="turno"
                           type="radio"
                           value="Mañana"
                           class="form-check-input"
                           id="turnoManana" />
                    <label class="form-check-label" for="turnoManana">
                        Mañana
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="turno"
                           type="radio"
                           value="Tarde"
                           class="form-check-input"
                           id="turnoTarde" />
                    <label class="form-check-label" for="turnoTarde">
                        Tarde
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="turno"
                           type="radio"
                           value="Noche"
                           class="form-check-input"
                           id="turnoNoche" />
                    <label class="form-check-label" for="turnoNoche">
                        Noche
                    </label>
                </div>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Guardar cambios"
                       class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="EmpleadoHome">Volver a la gestion de empleados</a> ||
    <a asp-action="IndexActualizar">Volver</a>
</div>

<script>
    const cargosPorArea = {
        "Administracion": ["Administrador", "Asistente administrativo"],
        "Ventas y Caja": ["Cajero", "Vendedor"],
        "Servicio al cliente": ["Servicio al cliente"],
        "Corte y Preparacion": ["Carnicero", "Despostador", "Empacador"],
        "Bodega e Inventario": ["Bodeguero", "Auxiliar de inventario"],
        "Distribucion": ["Conductor", "Ayudante de distribución"],
        "Limpieza": ["Personal de limpieza"]
    };

    const areaSelect = document.getElementById("areaTrabajo");
    const cargoSelect = document.getElementById("cargo");

    function cargarCargos() {
        const area = areaSelect.value;
        cargoSelect.innerHTML = "";

        if (!area || !cargosPorArea[area]) {
            cargoSelect.innerHTML = '<option value="">Primero seleccione un área</option>';
            return;
        }

        cargosPorArea[area].forEach(c => {
            const opt = document.createElement("option");
            opt.value = c;
            opt.textContent = c;
            cargoSelect.appendChild(opt);
        });
    }

    areaSelect.addEventListener("change", cargarCargos);

    document.addEventListener("DOMContentLoaded", function () {
        cargarCargos();
        cargoSelect.value = "@Html.Raw(Model?.cargo ?? "")";
    });
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}